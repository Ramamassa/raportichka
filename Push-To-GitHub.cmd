@echo off
chcp 65001 >nul
title Отправка файлов Рапортички на GitHub

echo ========================================================
echo        Отправка файлов в репозиторий GitHub
echo ========================================================
echo.

git push -u origin main --force

if %errorlevel% neq 0 (
  echo.
  echo --------------------------------------------------------
  echo Если появилась ошибка "Repository not found":
  echo 1. Проверьте точный адрес вашего репозитория на GitHub.
  echo 2. Убедитесь, правильный ли логин (Ramamasa или Ramamassa).
  echo 3. Если репозиторий Private, войдите через GitHub Credential Manager
  echo    в появившемся окне браузера.
  echo --------------------------------------------------------
) else (
  echo.
  echo ========================================================
  echo УСПЕШНО! Все файлы отправлены на GitHub!
  echo Теперь перейдите в Vercel и нажмите Redeploy.
  echo ========================================================
)
echo.
pause
